# ===== SIAGA: contoh konfigurasi. Salin ke .env lalu isi. =====
NODE_ENV=production

# --- Database & cache ---
DATABASE_URL=postgresql://siaga:GANTI_PASSWORD@127.0.0.1:5432/siaga
REDIS_URL=redis://127.0.0.1:6379/0

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Asal yang boleh memanggil API dari browser (pisahkan koma). Kosongkan bila web dan API satu domain lewat Nginx.
CORS_ORIGINS=
# URL publik aplikasi, dipakai di tautan pesan peringatan
PUBLIC_APP_URL=https://siaga.example.id
# Garam untuk hash IP pelapor (string acak panjang)
IP_HASH_SALT=GANTI_DENGAN_STRING_ACAK
# Token untuk antrean moderasi (/moderasi). String acak panjang.
ADMIN_TOKEN=GANTI_DENGAN_TOKEN_ACAK

# --- Sumber data ---
# Kunci gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key . Tanpa kunci, worker memakai berkas CSV terbuka Asia Tenggara.
FIRMS_MAP_KEY=
# Kosong = API gratis Open-Meteo (hanya non-komersial). Isi kunci paket berbayar untuk produksi komersial.
OPEN_METEO_API_KEY=
# Matikan sumber yang belum punya izin pemakaian (lihat docs/SUMBER-DATA.md): 1 = aktif, 0 = mati
SOURCE_BMKG=1
SOURCE_USGS=1
SOURCE_OPEN_METEO=1
SOURCE_FIRMS=1
SOURCE_EONET=1
SOURCE_PETABENCANA=1
SOURCE_MAGMA=1
# User-Agent untuk semua permintaan ke sumber data
SOURCE_USER_AGENT=SIAGA/0.1 (+https://siaga.example.id)

# --- Penyimpanan foto laporan ---
# local = folder di VPS (disajikan Nginx), s3 = object storage S3-compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/siaga/photos
STORAGE_PUBLIC_BASE_URL=https://siaga.example.id/photos
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Peringatan ---
# Buat dengan: pnpm --filter @siaga/server vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@siaga.example.id
# Bot Telegram dari @BotFather. Webhook: https://<domain>/api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Business Cloud API (belum aktif secara default; butuh template pesan yang disetujui Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=siaga_peringatan
WHATSAPP_TEMPLATE_LANG=id

# --- Frontend (Next.js) ---
# Hanya untuk pengembangan: ke mana Next.js meneruskan /api
API_INTERNAL_URL=http://127.0.0.1:4000
